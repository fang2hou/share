{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": [
    "./**/*.ts",
    "../worker-configuration.d.ts",
    "../shared/protocol.ts",
    "../shared/i18n.ts"
  ]
}
